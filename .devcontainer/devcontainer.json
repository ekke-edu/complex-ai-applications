{
    "name": "AI-Course-FastAPI-MongoDB",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/complex-ai-applications",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.black-formatter",
                "qwtel.sqlite-viewer",
                "mongodb.mongodb-vscode"
            ]
        }
    },
    "forwardPorts": [
        8000, // FastAPI
        8501, // Streamlit
        27017, // MongoDB
        7474 // Neo4j
    ],
    "postCreateCommand": "pip install -r requirements.txt",
    "remoteUser": "vscode"
}