// .devcontainer/devcontainer.json (Részlet)
{
    "name": "AI-Course-FastAPI",
    "image": "mcr.microsoft.com/devcontainers/python:3.11",
    "features": {},
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.black-formatter"
            ]
        }
    },
    "forwardPorts": [
        1521,
        8000
    ],
    "postCreateCommand": "pip install -r /workspaces/complex-ai-applications/requirements.txt",
    "remoteUser": "vscode"
}